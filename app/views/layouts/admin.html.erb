<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= content_for?(:title) ? content_for(:title) : "Admin — Paris Unveiled" %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap" rel="stylesheet">
  <style>
    :root {
      --stone: #0d0d0d; --surface: #111; --parchment: #d4c5a0;
      --dim: #6a6a5a; --brass: #b9975a; --border: #1f1f1f;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--stone); color: var(--parchment); font-family: system-ui, -apple-system, sans-serif; -webkit-font-smoothing: antialiased; }
    a { color: inherit; text-decoration: none; }
    .serif { font-family: 'Cormorant Garamond', Georgia, serif; }
  </style>
</head>
<body>
  <nav style="padding:16px 32px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between;">
    <div style="display:flex; align-items:center; gap:24px;">
      <%= link_to admin_root_path, style: "display:flex; align-items:center; gap:10px;" do %>
        <span class="serif" style="font-size:13px; letter-spacing:0.12em; text-transform:uppercase; color:var(--parchment);">Paris Unveiled</span>
        <span style="font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--dim); border:1px solid var(--border); padding:2px 8px; border-radius:2px;">Admin</span>
      <% end %>
      <%= link_to "Bookings", admin_root_path, style: "font-size:13px; color:var(--dim);" %>
      <%= link_to "Payments", admin_stripe_path, style: "font-size:13px; color:var(--dim);" %>
    </div>
    <div style="display:flex; align-items:center; gap:20px;">
      <span style="font-size:12px; color:var(--dim);"><%= current_admin_user.name || current_admin_user.email %></span>
      <%= link_to "Log out", destroy_admin_user_session_path, data: { turbo_method: :delete }, style: "font-size:12px; color:#9a5a5a;" %>
    </div>
  </nav>

  <main>
    <%= yield %>
  </main>
</body>
</html>
