<% content_for :title, "Log in — Paris Unveiled" %>

<div style="min-height:100vh; display:flex; align-items:center; justify-content:center; padding:32px;">
  <div style="width:100%; max-width:380px;">
    <div style="text-align:center; margin-bottom:40px;">
      <p class="serif" style="font-size:13px; letter-spacing:0.12em; text-transform:uppercase; color:var(--parchment); margin:0 0 8px;">Paris Unveiled</p>
      <p style="font-size:13px; color:var(--dim); margin:0;">Admin dashboard</p>
    </div>

    <% if alert %>
      <div style="padding:12px 16px; background:#2a1a1a; border:1px solid #3a2a2a; border-radius:4px; margin-bottom:24px;">
        <p style="font-size:13px; color:#9a5a5a; margin:0;"><%= alert %></p>
      </div>
    <% end %>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div style="margin-bottom:20px;">
        <label style="display:block; font-size:11px; letter-spacing:0.08em; text-transform:uppercase; color:var(--dim); margin-bottom:8px;">Email</label>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
            style: "width:100%; padding:12px 16px; background:var(--surface); border:1px solid var(--border); border-radius:4px; color:var(--parchment); font-size:14px; outline:none;" %>
      </div>

      <div style="margin-bottom:28px;">
        <label style="display:block; font-size:11px; letter-spacing:0.08em; text-transform:uppercase; color:var(--dim); margin-bottom:8px;">Password</label>
        <%= f.password_field :password, autocomplete: "current-password",
            style: "width:100%; padding:12px 16px; background:var(--surface); border:1px solid var(--border); border-radius:4px; color:var(--parchment); font-size:14px; outline:none;" %>
      </div>

      <div style="display:flex; align-items:center; gap:8px; margin-bottom:28px;">
        <%= f.check_box :remember_me, style: "accent-color:var(--brass);" %>
        <label style="font-size:12px; color:var(--dim);">Remember me</label>
      </div>

      <%= f.submit "Log in",
          style: "width:100%; padding:12px; background:var(--brass); color:#0d0d0d; border:none; border-radius:4px; font-size:13px; font-weight:600; letter-spacing:0.04em; cursor:pointer;" %>
    <% end %>

    <% if devise_mapping.recoverable? %>
      <p style="text-align:center; margin:20px 0 0;">
        <%= link_to "Forgot your password?", new_password_path(resource_name),
            style: "font-size:12px; color:var(--dim); border-bottom:1px solid var(--border); padding-bottom:1px;" %>
      </p>
    <% end %>
  </div>
</div>
